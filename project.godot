config_version=5

[application]
config/name="CLUSTER"
config/features=PackedStringArray("4.6")
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.svg"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

# Godot's own export check warns that forward_plus is a desktop renderer and is not
# suitable for Android. For a 2D board game on cheap phones, gl_compatibility is the
# lightest path: lowest requirements, fastest startup, least GPU work per frame.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
